{
	"permissions": {
		"disableBypassPermissionsMode": "disable",
		"ask": ["Bash(curl:*)", "Bash(wget:*)", "WebSearch"],
		"deny": [
			"Bash(sudo:*)",
			"Read(id_rsa)",
			"Read(id_ed25519)",
			"Read(**/*token*)",
			"Read(**/*key*)",
			"Write(**/secrets/**)",
			"Bash(nc:*)",
			"Bash(psql:*)",
			"Bash(mysql:*)",
			"Bash(aws)"
		]
	},
	"hooks": {
		"SessionStart": [
			{
				"type": "command",
				"command": "\"$CLAUDE_PROJECT_DIR\"/scripts/setup-skills.sh"
			}
		]
	}
}
